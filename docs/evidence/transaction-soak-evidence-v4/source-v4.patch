index 0000000..b9c134e
--- /dev/null
+++ b/benchmarks/transactions/classify_join_test.go
@@ -0,0 +1,35 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/ms-xiaosnow/gosqlite/sqlite"
+)
+
+// Pure memory error trees only. No database, filesystem mutation or native hooks.
+func TestIndependentUnexpectedJoinedErrorsRemainFatal(t *testing.T) {
+	unexpected := errors.New("independent model diagnostic")
+	for _, tt := range []struct {
+		name string
+		err  error
+	}{
+		{"busy_plus_unknown", errors.Join(sqlite.ErrBusy, unexpected)},
+		{"busy_plus_changed", errors.Join(sqlite.ErrBusy, sqlite.ErrChanged)},
+		{"cancel_plus_unknown", errors.Join(context.Canceled, unexpected)},
+		{"deadline_plus_changed", errors.Join(context.DeadlineExceeded, sqlite.ErrChanged)},
+		{"first_sqlite_error_masks_later_io", errors.Join(&sqlite.Error{Code: sqlite.CodeBusy, Op: "memory", Err: sqlite.ErrBusy}, &sqlite.Error{Code: sqlite.CodeIOErr, Op: "memory", Err: unexpected})},
+		{"outer_busy_masks_inner_io", &sqlite.Error{Code: sqlite.CodeBusy, Op: "memory", Err: errors.Join(sqlite.ErrBusy, &sqlite.Error{Code: sqlite.CodeIOErr, Op: "memory", Err: unexpected})}},
+		{"wrapped_busy_unknown", fmt.Errorf("context: %w", errors.Join(sqlite.ErrBusy, unexpected))},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			c := Counts{Attempts: 1}
+			fatal := classify(&c, tt.err)
+			if !fatal || c.Failed != 1 || c.Busy != 0 || c.Canceled != 0 || ordinaryBusy(tt.err) {
+				t.Fatalf("unexpected joined diagnostic suppressed: fatal=%v counts=%+v ordinaryBusy=%v err=%v", fatal, c, ordinaryBusy(tt.err), tt.err)
+			}
+		})
+	}
+}
diff --git a/benchmarks/transactions/classify_test.go b/benchmarks/transactions/classify_test.go
new file mode 100644
index 0000000..01fcc1f
--- /dev/null
+++ b/benchmarks/transactions/classify_test.go
@@ -0,0 +1,84 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/ms-xiaosnow/gosqlite/internal/encstore"
+	"github.com/ms-xiaosnow/gosqlite/internal/vfs"
+	"github.com/ms-xiaosnow/gosqlite/internal/walindex"
+	"github.com/ms-xiaosnow/gosqlite/sqlite"
+)
+
+// Pure memory values only: no native callbacks, files or failing database I/O.
+type forbiddenOutcomeMethods struct{}
+
+func (*forbiddenOutcomeMethods) Error() string { panic("must not format unknown error") }
+func (*forbiddenOutcomeMethods) Is(error) bool { panic("must not call custom Is") }
+func (*forbiddenOutcomeMethods) As(any) bool   { panic("must not call custom As") }
+func (*forbiddenOutcomeMethods) Unwrap() error { panic("must not call custom Unwrap") }
+
+type uncomparableOutcome []byte
+
+func (uncomparableOutcome) Error() string { return "opaque diagnostic" }
+
+func TestStrictOutcomeGraph(t *testing.T) {
+	busy := func(e error) error { return &sqlite.Error{Code: sqlite.CodeBusy, Op: "memory", Err: e} }
+	cancel := func(e error) error { return &sqlite.Error{Code: sqlite.CodeInterrupt, Op: "memory", Err: e} }
+	for _, e := range []error{sqlite.ErrBusy, sqlite.ErrBusySnapshot, encstore.ErrBusySnapshot, fmt.Errorf("lock: %w: %w", sqlite.ErrBusy, vfs.ErrBusy), errors.Join(sqlite.ErrBusy, walindex.ErrBusy), busy(errors.Join(sqlite.ErrBusy, encstore.ErrBusy))} {
+		if got := errorOutcome(e); got != outcomeBusy || !ordinaryBusy(e) {
+			t.Fatalf("legitimate BUSY outcome=%v", got)
+		}
+	}
+	for _, e := range []error{context.Canceled, context.DeadlineExceeded, cancel(fmt.Errorf("operation: %w", context.Canceled)), errors.Join(busy(sqlite.ErrBusy), cancel(context.Canceled)), busy(errors.Join(sqlite.ErrBusy, context.Canceled))} {
+		if got := errorOutcome(e); got != outcomeCanceled || ordinaryBusy(e) {
+			t.Fatalf("legitimate cancellation outcome=%v", got)
+		}
+	}
+	cycle := &sqlite.Error{Code: sqlite.CodeBusy, Op: "memory-cycle"}
+	cycle.Err = cycle
+	var typedNil *sqlite.Error
+	var customNil *forbiddenOutcomeMethods
+	tooDeep := error(sqlite.ErrBusy)
+	for i := 0; i < maxOutcomeErrorNodes; i++ {
+		tooDeep = busy(tooDeep)
+	}
+	many := make([]error, maxOutcomeErrorNodes)
+	for i := range many {
+		many[i] = sqlite.ErrBusy
+	}
+	bad := []error{&forbiddenOutcomeMethods{}, customNil, uncomparableOutcome{1}, typedNil, cycle, tooDeep, errors.Join(many...), busy(nil), busy(context.Canceled), cancel(sqlite.ErrBusy), &sqlite.Error{Code: sqlite.CodeIOErr, Err: sqlite.ErrBusy}, &sqlite.Error{Code: sqlite.CodeCorrupt, Err: context.Canceled}, cleanupJoin(sqlite.ErrBusy, errors.New("consumed close diagnostic")), errors.Join(context.Canceled, errCleanup)}
+	for i, e := range bad {
+		var c Counts
+		c.Attempts = 1
+		if !classify(&c, e) || ordinaryBusy(e) || !c.Valid() || c.Failed != 1 {
+			t.Fatalf("bad graph %d accepted: counts=%+v", i, c)
+		}
+	}
+	if errorOutcome(nil) != outcomeSuccess {
+		t.Fatal("nil error not successful")
+	}
+	// Node budget is inclusive: envelope(s) plus one recognized leaf.
+	boundary := error(sqlite.ErrBusy)
+	for i := 1; i < maxOutcomeErrorNodes; i++ {
+		boundary = busy(boundary)
+	}
+	if errorOutcome(boundary) != outcomeBusy {
+		t.Fatal("exact budget refused")
+	}
+}
+
+func TestGenerationAbsencePreservesIteratorErrors(t *testing.T) {
+	if missingGenerationError(context.Canceled) != context.Canceled {
+		t.Fatal("cancellation relabeled missing row")
+	}
+	joined := errors.Join(context.Canceled, errors.New("iterator diagnostic"))
+	if missingGenerationError(joined) != joined || errorOutcome(missingGenerationError(joined)) != outcomeFailed {
+		t.Fatal("iterator diagnostic suppressed")
+	}
+	if errorOutcome(missingGenerationError(nil)) != outcomeFailed {
+		t.Fatal("clean missing row accepted")
+	}
+}
diff --git a/benchmarks/transactions/closure.go b/benchmarks/transactions/closure.go
new file mode 100644
index 0000000..4ddf9c1
--- /dev/null
+++ b/benchmarks/transactions/closure.go
@@ -0,0 +1,232 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"github.com/ms-xiaosnow/gosqlite/sqlite"
+	"reflect"
+	"strings"
+)
+
+// closeLedger is single-goroutine-owned. Workers finish before their DB handles
+// are closed. Failed handles and original diagnostics stay owned; an unrelated
+// successful Close cannot clear the historical failure or prove their retirement.
+type closeHandle interface{ Close() error }
+type ownedHandle struct {
+	handle     closeHandle
+	label      string
+	attempted  bool
+	diagnostic error
+}
+type closeLedger struct {
+	live     map[*ownedHandle]struct{}
+	failures int
+	acquired int
+}
+
+func newCloseLedger() *closeLedger { return &closeLedger{live: make(map[*ownedHandle]struct{})} }
+func (l *closeLedger) acquire(handle closeHandle, label string) *ownedHandle {
+	owner := &ownedHandle{handle: handle, label: label}
+	l.live[owner] = struct{}{}
+	l.acquired++
+	return owner
+}
+func (l *closeLedger) close(owner *ownedHandle) error {
+	if owner == nil {
+		return nil
+	}
+	if _, ok := l.live[owner]; !ok {
+		return nil
+	}
+	// A second nil Close is not proof of retirement for one-shot rollback handles.
+	// Preserve this owner/diagnostic for its documented cleanup route instead.
+	if owner.attempted {
+		return owner.diagnostic
+	}
+	owner.attempted = true
+	if err := owner.handle.Close(); err != nil {
+		l.failures++
+		owner.diagnostic = fmt.Errorf("%s close: %w", owner.label, err)
+		return owner.diagnostic
+	}
+	delete(l.live, owner)
+	owner.handle = nil
+	return nil
+}
+func (l *closeLedger) closeRemaining() error {
+	var err error
+	for owner := range l.live {
+		if !owner.attempted {
+			err = errors.Join(err, l.close(owner))
+		}
+	}
+	return err
+}
+func (l *closeLedger) shutdown() string {
+	if len(l.live) > 0 {
+		return "close_error_unverified_retirement"
+	}
+	if l.failures > 0 {
+		return "close_error"
+	}
+	if l.acquired == 0 {
+		return "no_database_handle_returned"
+	}
+	return "workers_joined_normal_close"
+}
+
+// cleanupDiagnostic refuses to infer retirement from a bare success elsewhere.
+// All public pending markers, IO/poison/uncertain diagnostics, opaque envelopes
+// and malformed/excessive graphs are conservatively unverified. No custom
+// Is/As/Error/Unwrap method is called while discovering ownership diagnostics.
+func cleanupDiagnostic(err error) bool {
+	if err == nil {
+		return false
+	}
+	stack := []error{err}
+	visited := 0
+	for len(stack) > 0 {
+		if visited >= maxOutcomeErrorNodes {
+			return true
+		}
+		visited++
+		node := stack[len(stack)-1]
+		stack = stack[:len(stack)-1]
+		if node == nil {
+			return true
+		}
+		if value := reflect.ValueOf(node); value.Kind() == reflect.Pointer && value.IsNil() {
+			return true
+		}
+		switch node {
+		case errCleanup, sqlite.ErrPlaintextCleanupPending, sqlite.ErrOpenCleanupPending, sqlite.ErrCloseCleanupPending, sqlite.ErrEncryptedCleanupPending, sqlite.ErrPoisoned, sqlite.ErrCommitUncertain, sqlite.ErrRecoveryRequired:
+			return true
+		}
+		if e, ok := node.(*sqlite.Error); ok {
+			if e == nil || e.Code == sqlite.CodeIOErr || e.Err == nil {
+				return true
+			}
+			stack = append(stack, e.Err)
+			continue
+		}
+		typ := reflect.TypeOf(node)
+		// Standard terminal error strings and exact context sentinels have no hidden
+		// owner envelope. Arbitrary custom leaves may hide one and stay unverified.
+		if typ == terminalErrorType || node == context.Canceled || node == context.DeadlineExceeded {
+			continue
+		}
+		if typ != singleWrapType && typ != multiWrapType && typ != joinType {
+			return true
+		}
+		if reflect.ValueOf(node).IsNil() {
+			return true
+		}
+		if typ == singleWrapType {
+			stack = append(stack, node.(interface{ Unwrap() error }).Unwrap())
+			continue
+		}
+		children := node.(interface{ Unwrap() []error }).Unwrap()
+		if len(children) == 0 || len(children) > maxOutcomeErrorNodes-visited-len(stack) {
+			return true
+		}
+		stack = append(stack, children...)
+	}
+	return false
+}
+
+// recordFailure retains original token/error graphs even if Open returned no DB.
+// Unsafe retirement is latched immediately, before any enclosing finalizer.
+func recordFailure(rep *Report, err error) {
+	if err == nil {
+		return
+	}
+	rep.retainedDiagnostics = append(rep.retainedDiagnostics, err)
+	rep.Errors = append(rep.Errors, diagnosticText(err))
+	if cleanupDiagnostic(err) {
+		rep.UnverifiedRetirement = true
+	}
+	setReportStatus(rep, "failed")
+}
+func setReportStatus(rep *Report, status string) {
+	rep.Status = status
+	if rep.UnverifiedRetirement {
+		rep.Status = "failed"
+		rep.Shutdown = "close_error_unverified_retirement"
+	}
+}
+func recordOpenFailure(rep *Report, err error) {
+	recordFailure(rep, err)
+	if !rep.UnverifiedRetirement && benignUnsupported(err) {
+		setReportStatus(rep, "skipped_unsupported")
+	}
+}
+
+// diagnosticText is bounded too: unknown error callbacks and cyclic SQLite
+// envelopes are never invoked while formatting the retained failure report.
+func diagnosticText(err error) string {
+	remaining := maxOutcomeErrorNodes
+	var render func(error) string
+	clip := func(s string) string {
+		if len(s) > 1024 {
+			return s[:1024] + " [truncated]"
+		}
+		return s
+	}
+	render = func(node error) string {
+		if remaining == 0 {
+			return "[error graph limit]"
+		}
+		remaining--
+		if node == nil {
+			return "[nil diagnostic]"
+		}
+		if value := reflect.ValueOf(node); value.Kind() == reflect.Pointer && value.IsNil() {
+			return "[typed nil diagnostic]"
+		}
+		if e, ok := node.(*sqlite.Error); ok {
+			if e == nil {
+				return "[nil SQLite diagnostic]"
+			}
+			return fmt.Sprintf("sqlite %s (code %d): %s", clip(e.Op), e.Code, render(e.Err))
+		}
+		typ := reflect.TypeOf(node)
+		if typ == terminalErrorType || node == context.Canceled || node == context.DeadlineExceeded {
+			return clip(node.Error())
+		}
+		if typ == singleWrapType || typ == multiWrapType {
+			if reflect.ValueOf(node).IsNil() {
+				return "[nil format wrapper]"
+			}
+			return clip(node.Error())
+		}
+		if typ == joinType {
+			if reflect.ValueOf(node).IsNil() {
+				return "[nil join wrapper]"
+			}
+			children := node.(interface{ Unwrap() []error }).Unwrap()
+			if len(children) > remaining {
+				return "[error graph limit]"
+			}
+			var parts []string
+			for _, child := range children {
+				parts = append(parts, render(child))
+			}
+			return strings.Join(parts, "; ")
+		}
+		return fmt.Sprintf("[opaque diagnostic %T; original retained]", node)
+	}
+	return render(err)
+}
+
+func finalizeClosures(rep *Report, owners *closeLedger) error {
+	err := owners.closeRemaining()
+	rep.UnverifiedCloseHandles = len(owners.live)
+	rep.CloseFailures = owners.failures
+	rep.Shutdown = owners.shutdown()
+	if owners.failures > 0 || len(owners.live) > 0 {
+		rep.UnverifiedRetirement = true
+	}
+	setReportStatus(rep, rep.Status)
+	return err
+}
diff --git a/benchmarks/transactions/closure_test.go b/benchmarks/transactions/closure_test.go
new file mode 100644
index 0000000..693a08e
--- /dev/null
+++ b/benchmarks/transactions/closure_test.go
@@ -0,0 +1,107 @@
+package main
+
+import (
+	"errors"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"testing"
+)
+
+// The fakes below are descriptor-free memory objects, not database/native hooks.
+type memoryCloseHandle struct {
+	calls int
+	err   error
+}
+
+func (m *memoryCloseHandle) Close() error { m.calls++; return m.err }
+func TestCloseLedgerRetainsFailures(t *testing.T) {
+	l := newCloseLedger()
+	bad := &memoryCloseHandle{err: errors.New("memory diagnostic")}
+	good := &memoryCloseHandle{}
+	failed := l.acquire(bad, "reader")
+	writer := l.acquire(good, "writer")
+	if l.close(failed) == nil || l.failures != 1 || len(l.live) != 2 || failed.handle != bad || failed.diagnostic == nil {
+		t.Fatal("failed owner lost")
+	}
+	// A hypothetical second nil result must not be mistaken for proof that the
+	// one-shot original owner retired. No automatic retry is invoked.
+	bad.err = nil
+	if l.close(failed) == nil || bad.calls != 1 {
+		t.Fatal("failed owner blindly retried")
+	}
+	if err := l.close(writer); err != nil {
+		t.Fatal(err)
+	}
+	if l.shutdown() != "close_error_unverified_retirement" || len(l.live) != 1 || failed.handle != bad {
+		t.Fatal("writer success hid reader failure")
+	}
+	if err := l.closeRemaining(); err != nil || bad.calls != 1 {
+		t.Fatal("unrequested retry", err)
+	}
+	clean := newCloseLedger()
+	a, b := &memoryCloseHandle{}, &memoryCloseHandle{}
+	clean.acquire(a, "one")
+	clean.acquire(b, "two")
+	if clean.closeRemaining() != nil || a.calls != 1 || b.calls != 1 || len(clean.live) != 0 || clean.shutdown() != "workers_joined_normal_close" {
+		t.Fatal("clean ledger")
+	}
+}
+func TestCleanupDiagnosticLatchDiscovery(t *testing.T) {
+	if !cleanupDiagnostic(cleanupJoin(nil, errors.New("memory rows close"))) || !cleanupDiagnostic(errors.Join(errors.New("operation"), cleanupJoin(nil, errors.New("memory tx rollback")))) {
+		t.Fatal("cleanup marker lost")
+	}
+	if cleanupDiagnostic(errors.New("model mismatch")) || cleanupDiagnostic(nil) {
+		t.Fatal("plain memory failure incorrectly marked unverified")
+	}
+}
+func TestDBCloseOnlyThroughLedger(t *testing.T) {
+	// Source contract: native DB Close is centralized in the ledger. In
+	// particular, the epoch error path cannot nil out a failed DB owner.
+	for _, path := range []string{"main.go", "workload.go"} {
+		file, err := parser.ParseFile(token.NewFileSet(), path, nil, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ast.Inspect(file, func(n ast.Node) bool {
+			call, ok := n.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			sel, ok := call.Fun.(*ast.SelectorExpr)
+			if !ok || sel.Sel.Name != "Close" {
+				return true
+			}
+			id, ok := sel.X.(*ast.Ident)
+			if ok && (id.Name == "db" || id.Name == "writer") {
+				t.Errorf("raw DB.Close bypass in %s", path)
+			}
+			return true
+		})
+	}
+}
+
+func TestFinalClosureReportCannotEraseReaderFailure(t *testing.T) {
+	l := newCloseLedger()
+	reader := l.acquire(&memoryCloseHandle{err: errors.New("memory reader close")}, "reader")
+	if l.close(reader) == nil {
+		t.Fatal("fixture")
+	}
+	writer := &memoryCloseHandle{}
+	l.acquire(writer, "writer")
+	rep := Report{Status: "passed", retainedOwners: l}
+	if finalizeClosures(&rep, l) != nil {
+		t.Fatal("historical reader error must not be retried")
+	}
+	if rep.Status != "failed" || !rep.UnverifiedRetirement || rep.Shutdown != "close_error_unverified_retirement" || rep.UnverifiedCloseHandles != 1 || rep.CloseFailures != 1 || writer.calls != 1 || reader.handle == nil {
+		t.Fatalf("false closure report: %+v", rep)
+	}
+	// Nested Rows/Tx retirement diagnostics remain unverified even if all DB
+	// handles subsequently close without a fresh diagnostic.
+	clean := newCloseLedger()
+	clean.acquire(&memoryCloseHandle{}, "writer")
+	nested := Report{Status: "failed", UnverifiedRetirement: true}
+	if finalizeClosures(&nested, clean) != nil || nested.Shutdown != "close_error_unverified_retirement" || !nested.UnverifiedRetirement {
+		t.Fatal("nested retirement diagnostic erased")
+	}
+}
