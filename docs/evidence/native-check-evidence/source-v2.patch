+		{"unknown schema", func(t *testing.T, m *checkMemory) {
+			if err := btree.InsertTable(context.Background(), m, 1, 3, []any{"view", "v", "v", int64(0), "CREATE VIEW v AS SELECT 1"}); err != nil {
+				t.Fatal(err)
