diff --git a/cmd/gosqlite/key_provider.go b/cmd/gosqlite/key_provider.go
new file mode 100644
index 0000000..3d33323
--- /dev/null
+++ b/cmd/gosqlite/key_provider.go
@@ -0,0 +1,187 @@
+package main
+
+import (
+	"context"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"runtime"
+	"strings"
+	"sync"
+
+	"github.com/ms-xiaosnow/gosqlite/encryption"
+)
+
+type credentialInput struct {
+	lookupEnv func(string) (string, bool)
+	stdin     func() (io.Reader, error)
+}
+
+// Providers are bound to explicit local input descriptors. Unauthenticated
+// KeyRequest IDs/path never select accounts, commands, URLs or credential names.
+// Acquisition stays lazy so the native API can enforce platform/KDF preflight.
+type cliKeyProvider struct {
+	mu        sync.Mutex
+	kind      encryption.CredentialKind
+	name      string
+	fromStdin bool
+	input     credentialInput
+	key       []byte
+	attempted bool
+	closed    bool
+}
+
+func (*cliKeyProvider) Format(s fmt.State, verb rune) {
+	_, _ = io.WriteString(s, "gosqlite.keyProvider{redacted}")
+}
+
+func newCLIKeyProvider(descriptor string, input credentialInput) (*cliKeyProvider, error) {
+	p := &cliKeyProvider{input: input}
+	switch {
+	case strings.HasPrefix(descriptor, "env-hex:"):
+		p.kind, p.name = encryption.RawKey256, strings.TrimPrefix(descriptor, "env-hex:")
+	case strings.HasPrefix(descriptor, "env-password:"):
+		p.kind, p.name = encryption.PasswordArgon2id, strings.TrimPrefix(descriptor, "env-password:")
+	case descriptor == "stdin-hex":
+		p.kind, p.fromStdin = encryption.RawKey256, true
+	case descriptor == "stdin-password":
+		p.kind, p.fromStdin = encryption.PasswordArgon2id, true
+	default:
+		return nil, errors.New(providerHelp)
+	}
+	if !p.fromStdin && !validEnvironmentName(p.name) {
+		return nil, errors.New("provider requires an explicit ASCII environment-variable name; " + providerHelp)
+	}
+	return p, nil
+}
+
+func validEnvironmentName(s string) bool {
+	if len(s) == 0 || len(s) > 128 {
+		return false
+	}
+	for i := range len(s) {
+		b := s[i]
+		if b == '_' || b >= 'A' && b <= 'Z' || b >= 'a' && b <= 'z' || i > 0 && b >= '0' && b <= '9' {
+			continue
+		}
+		return false
+	}
+	return true
+}
+
+func (p *cliKeyProvider) Acquire(ctx context.Context, request encryption.KeyRequest) (encryption.KeyMaterial, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.closed || request.Kind != p.kind {
+		return nil, encryption.ErrCredential
+	}
+	if !p.attempted {
+		p.attempted = true
+		key, err := p.readCredential(ctx)
+		if err != nil {
+			return nil, err
+		}
+		p.key = key
+	}
+	if len(p.key) == 0 {
+		return nil, encryption.ErrKeyProvider
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	return &cliKeyMaterial{kind: p.kind, key: append([]byte(nil), p.key...)}, nil
+}
+
+func (p *cliKeyProvider) readCredential(ctx context.Context) ([]byte, error) {
+	maxBytes := encryption.MaxPasswordBytes
+	if p.kind == encryption.RawKey256 {
+		maxBytes = encryption.KeySize * 2
+	}
+	var encoded []byte
+	if p.fromStdin {
+		if p.input.stdin == nil {
+			return nil, encryption.ErrKeyProvider
+		}
+		in, err := p.input.stdin()
+		if err != nil || in == nil {
+			return nil, encryption.ErrKeyProvider
+		}
+		// EOF terminates exactly one bounded credential. Raw hex may have one
+		// LF or CRLF. Password bytes, including trailing newlines, are exact.
+		limit := maxBytes
+		if p.kind == encryption.RawKey256 {
+			limit += 2
+		}
+		// Allocate once: growing io.ReadAll buffers can leave earlier copies
+		// of credential bytes in allocations we can no longer clear.
+		encoded = make([]byte, limit+1)
+		defer clearCredential(encoded)
+		n, err := io.ReadFull(in, encoded)
+		if (err != io.EOF && err != io.ErrUnexpectedEOF) || n > limit {
+			return nil, encryption.ErrKeyProvider
+		}
+		encoded = encoded[:n]
+		if p.kind == encryption.RawKey256 && len(encoded) > 0 && encoded[len(encoded)-1] == '\n' {
+			encoded = encoded[:len(encoded)-1]
+			if len(encoded) > 0 && encoded[len(encoded)-1] == '\r' {
+				encoded = encoded[:len(encoded)-1]
+			}
+		}
+	} else {
+		if p.input.lookupEnv == nil {
+			return nil, encryption.ErrKeyProvider
+		}
+		value, ok := p.input.lookupEnv(p.name)
+		if !ok || len(value) == 0 || len(value) > maxBytes {
+			return nil, encryption.ErrKeyProvider
+		}
+		encoded = []byte(value)
+		defer clearCredential(encoded)
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	if p.kind == encryption.PasswordArgon2id {
+		if len(encoded) == 0 || len(encoded) > maxBytes {
+			return nil, encryption.ErrCredential
+		}
+		return append([]byte(nil), encoded...), nil
+	}
+	if len(encoded) != maxBytes {
+		return nil, encryption.ErrCredential
+	}
+	key := make([]byte, encryption.KeySize)
+	if _, err := hex.Decode(key, encoded); err != nil {
+		clearCredential(key)
+		return nil, encryption.ErrCredential
+	}
+	return key, nil
+}
+
+func (p *cliKeyProvider) close() {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	clearCredential(p.key)
+	p.key = nil
+	p.closed = true
+}
+
+type cliKeyMaterial struct {
+	kind encryption.CredentialKind
+	key  []byte
+}
+
+func (*cliKeyMaterial) Format(s fmt.State, verb rune) {
+	_, _ = io.WriteString(s, "gosqlite.keyMaterial{redacted}")
+}
+func (m *cliKeyMaterial) Kind() encryption.CredentialKind { return m.kind }
+func (m *cliKeyMaterial) Bytes() []byte                   { return m.key }
+func (m *cliKeyMaterial) Release() {
+	clearCredential(m.key)
+	m.key = nil
+}
+func clearCredential(b []byte) { clear(b); runtime.KeepAlive(b) }
diff --git a/cmd/gosqlite/key_provider_test.go b/cmd/gosqlite/key_provider_test.go
new file mode 100644
index 0000000..c81e866
--- /dev/null
+++ b/cmd/gosqlite/key_provider_test.go
@@ -0,0 +1,181 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/ms-xiaosnow/gosqlite/encryption"
+)
+
+func disposableCLIKey(t *testing.T) []byte {
+	t.Helper()
+	key := make([]byte, encryption.KeySize)
+	if _, err := rand.Read(key); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { clearCredential(key) })
+	return key
+}
+
+func TestCLIProviderMemorySourcesAndRelease(t *testing.T) {
+	ctx := context.Background()
+	key := disposableCLIKey(t)
+	for _, ending := range []string{"", "\n", "\r\n"} {
+		p, err := newCLIKeyProvider("stdin-hex", credentialInput{stdin: func() (io.Reader, error) {
+			return strings.NewReader(hex.EncodeToString(key) + ending), nil
+		}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		for range 2 {
+			m, err := p.Acquire(ctx, encryption.KeyRequest{Kind: encryption.RawKey256})
+			if err != nil || !bytes.Equal(m.Bytes(), key) {
+				t.Fatal("stdin credential mismatch")
+			}
+			borrow := m.Bytes()
+			m.Release()
+			if !bytes.Equal(borrow, make([]byte, len(borrow))) {
+				t.Fatal("borrow was not cleared")
+			}
+		}
+		owned := p.key
+		p.close()
+		if !bytes.Equal(owned, make([]byte, len(owned))) {
+			t.Fatal("owned credential was not cleared")
+		}
+	}
+	for _, descriptor := range []string{"env-password:LOCAL_PASSWORD", "stdin-password"} {
+		password := "exact password\x00 bytes \r\n"
+		p, err := newCLIKeyProvider(descriptor, credentialInput{
+			lookupEnv: func(name string) (string, bool) { return password, true },
+			stdin:     func() (io.Reader, error) { return strings.NewReader(password), nil },
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		m, err := p.Acquire(ctx, encryption.KeyRequest{Kind: encryption.PasswordArgon2id})
+		if err != nil || string(m.Bytes()) != password {
+			t.Fatal("password bytes were modified")
+		}
+		m.Release()
+		p.close()
+	}
+}
+
+func TestCLIProviderMemoryBoundsAndRedaction(t *testing.T) {
+	const marker = "private-input-marker-do-not-print"
+	for _, descriptor := range []string{marker, "raw:" + marker, "env-hex:", "env-hex:9BAD", "env-password:BAD-NAME", "env-hex:" + strings.Repeat("A", 129)} {
+		_, err := newCLIKeyProvider(descriptor, credentialInput{})
+		if err == nil || strings.Contains(err.Error(), marker) {
+			t.Fatal("invalid provider descriptor was accepted or disclosed")
+		}
+	}
+	for _, tc := range []struct {
+		descriptor, value string
+	}{
+		{"env-hex:KEY", ""}, {"env-hex:KEY", marker},
+		{"env-hex:KEY", strings.Repeat("z", 64)},
+		{"env-hex:KEY", strings.Repeat("a", 65)},
+		{"stdin-hex", strings.Repeat("a", 64) + "\n\n"},
+		{"stdin-hex", strings.Repeat("a", 67)},
+		{"stdin-password", ""},
+		{"env-password:KEY", strings.Repeat("p", encryption.MaxPasswordBytes+1)},
+		{"stdin-password", strings.Repeat("p", encryption.MaxPasswordBytes+1)},
+	} {
+		p, err := newCLIKeyProvider(tc.descriptor, credentialInput{
+			lookupEnv: func(string) (string, bool) { return tc.value, true },
+			stdin:     func() (io.Reader, error) { return strings.NewReader(tc.value), nil },
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		m, err := p.Acquire(context.Background(), encryption.KeyRequest{Kind: p.kind})
+		if err == nil || m != nil || strings.Contains(err.Error(), marker) {
+			t.Fatal("invalid memory credential was accepted or disclosed")
+		}
+		p.close()
+	}
+	p, err := newCLIKeyProvider("env-password:SECRET_NAME", credentialInput{lookupEnv: func(string) (string, bool) { return marker, true }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.close()
+	m, err := p.Acquire(context.Background(), encryption.KeyRequest{Kind: p.kind})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer m.Release()
+	for _, value := range []any{p, m} {
+		for _, verb := range []string{"%v", "%+v", "%#v", "%s", "%q"} {
+			if rendered := fmt.Sprintf(verb, value); strings.Contains(rendered, marker) || strings.Contains(rendered, "SECRET_NAME") || !strings.Contains(rendered, "redacted") {
+				t.Fatal("provider/material formatting was not redacted")
+			}
+		}
+	}
+}
+
+func TestCLIProviderMemoryConcurrencyAndCancellation(t *testing.T) {
+	key := disposableCLIKey(t)
+	reads := 0
+	p, err := newCLIKeyProvider("env-hex:KEY", credentialInput{lookupEnv: func(string) (string, bool) {
+		reads++
+		return hex.EncodeToString(key), true
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := p.Acquire(ctx, encryption.KeyRequest{Kind: p.kind}); !errors.Is(err, context.Canceled) || reads != 0 {
+		t.Fatal("canceled acquisition consumed input")
+	}
+	if _, err := p.Acquire(context.Background(), encryption.KeyRequest{Kind: encryption.PasswordArgon2id}); !errors.Is(err, encryption.ErrCredential) || reads != 0 {
+		t.Fatal("mismatched kind consumed input")
+	}
+	var wg sync.WaitGroup
+	for range 8 {
+		wg.Go(func() {
+			m, err := p.Acquire(context.Background(), encryption.KeyRequest{Kind: p.kind})
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			if !bytes.Equal(m.Bytes(), key) {
+				t.Error("concurrent borrow mismatch")
+			}
+			m.Release()
+		})
+	}
+	wg.Wait()
+	if reads != 1 {
+		t.Fatal("provider did not cache a single bounded acquisition")
+	}
+	p.close()
+	if _, err := p.Acquire(context.Background(), encryption.KeyRequest{Kind: p.kind}); !errors.Is(err, encryption.ErrCredential) {
+		t.Fatal("closed provider accepted acquisition")
+	}
+}
+
+func TestCLIProviderMemoryInputFailureRedaction(t *testing.T) {
+	// This is a synthetic input-provider error only, not a filesystem fault.
+	const marker = "input-provider-private-message"
+	p, err := newCLIKeyProvider("stdin-password", credentialInput{stdin: func() (io.Reader, error) {
+		return nil, errors.New(marker)
+	}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.close()
+	_, err = p.Acquire(context.Background(), encryption.KeyRequest{Kind: p.kind})
+	if !errors.Is(err, encryption.ErrKeyProvider) || strings.Contains(err.Error(), marker) {
+		t.Fatal("input provider error escaped")
+	}
+}
