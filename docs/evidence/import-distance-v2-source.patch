+			if err != nil || !reflect.DeepEqual(supplied.Distances.QueryPKs, options.QueryPKs) || supplied.Distances.QuerySelection != "supplied_source_pks" {
+				t.Fatal(supplied, err)
+			}
+		})
+	}
